# Optional Docker Compose settings. `docker compose up --build --wait` works without this file.
# Copy to .env only when changing these defaults. Never commit your real .env.
NOTER_PORT=8081
# Empty uses the build's UTC month (YY.MM). CI supplies an explicit month and commit.
NOTER_BUILD_VERSION=
NOTER_BUILD_COMMIT=unknown

# Native source builds (export explicitly in your shell; Go does not automatically load .env).
# The MEMOS_ prefix is retained for compatibility; these are Noter.ai server settings.
# MEMOS_ADDR=127.0.0.1
# MEMOS_PORT=8081
# MEMOS_DRIVER=sqlite
# MEMOS_DATA=/absolute/path/to/noter-profile
# MEMOS_DSN=                       # Only needed for an external database; keep passwords private.
# NOTER_LIBRARY_ROOT=/absolute/path/to/noter-library
# DEV_PROXY_SERVER=http://127.0.0.1:8081

# Optional publisher-owned Google installed-client configuration for source builds.
# End-user AI keys/accounts belong in the app settings, never in source or images.
# NOTER_ANTIGRAVITY_CLIENT_ID=
# NOTER_ANTIGRAVITY_CLIENT_SECRET=

# Tests only: explicitly skips Docker-dependent database tests on machines without Docker.
# Never set this in CI; a skipped database test is not a passing integration test.
# SKIP_CONTAINER_TESTS=1
# NOTER_DESKTOP is set by the native launcher; do not enable desktop-only operations in a server container.
