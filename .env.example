# Optional Docker Compose settings. `docker compose up --build --wait` works without this file.
# Copy to .env only when changing these defaults. Never commit your real .env.
# Only Compose reads this file automatically. Export other settings in the shell
# running the matching server, desktop, website or test command.
NOTER_PORT=8081
# Empty uses the build's UTC month (YY.MM). CI supplies an explicit month and commit.
NOTER_BUILD_VERSION=
NOTER_BUILD_COMMIT=unknown

# Native source builds (export explicitly in your shell; Go does not automatically load .env).
# The MEMOS_ prefix is retained for compatibility; these are Noter.ai server settings.
# MEMOS_ADDR=127.0.0.1
# MEMOS_PORT=8081
# MEMOS_UNIX_SOCK=                 # Unix socket overrides the server address/port.
# MEMOS_DRIVER=sqlite
# MEMOS_DATA=/absolute/path/to/noter-profile
# MEMOS_DSN=                       # Only needed for an external database; keep passwords private.
# MEMOS_INSTANCE_URL=              # Canonical external http(s) origin when deployed.
# MEMOS_DEMO=false                 # Disposable demo behavior; SQLite only.
# MEMOS_LOG_LEVEL=info             # debug, info, warn or error.
# MEMOS_RATE_LIMIT=true
# MEMOS_TRUSTED_PROXIES=none        # Direct access; reverse proxies need an explicit trusted CIDR list.
# MEMOS_WEBHOOK_PRIVATE_NETWORK_ALLOWLIST= # Optional specific private destinations, comma-separated.
# MEMOS_ALLOW_PRIVATE_WEBHOOKS=false # Deprecated broad bypass; prefer the allowlist above.
# NOTER_LIBRARY_ROOT=/absolute/path/to/noter-library
# Frontend development proxy target (Vite only).
# DEV_PROXY_SERVER=http://127.0.0.1:8081

# Native desktop launcher. These paths are normally selected by the app.
# NOTER_PORT above is also the native launcher's preferred loopback port.
# NOTER_DATA_DIR=/absolute/path/to/noter-profile
# NOTER_WEBVIEW_DATA_DIR=/absolute/path/to/noter-webview
# Launcher-owned child-server marker, not a switch for browser/server installs.
# NOTER_DESKTOP=1

# Optional publisher-owned Google installed-client configuration for source builds.
# End-user AI keys/accounts belong in the app settings, never in source or images.
# NOTER_ANTIGRAVITY_CLIENT_ID=
# NOTER_ANTIGRAVITY_CLIENT_SECRET=
# Desktop release build input, stored in Actions secrets by the publisher.
# Only an installed/desktop client JSON is accepted; never use a web-client secret.
# Do not put personal account tokens here. Ordinary users connect inside the app.
# NOTER_DESKTOP_GOOGLE_OAUTH_JSON=

# Public website build and local preview only; these do not configure the app.
# SITE_URL=https://mrfost07.github.io/noter.ai/
# PORT=3035

# Tests only. The cross-platform workstation runner sets DRIVER and the skip flag
# for its child process: node scripts/local-test.mjs . No app account is needed.
# DRIVER=sqlite                   # Test driver; the server uses MEMOS_DRIVER instead.
# SKIP_CONTAINER_TESTS=1
# Never set the skip flag in the full CI matrix; skipped integrations are not passes.
# NOTER_TEST_URL=http://127.0.0.1:8081 # Running disposable Compose project for container-smoke.mjs.
# MEMOS_TEST_IMAGE_BUILT=1         # Harness marker: candidate container test image is already built.
# MEMOS_SMOKE_CANDIDATE_IMAGE=     # Optional upgrade-smoke candidate server image.
# MEMOS_SMOKE_PREVIOUS_IMAGE=      # Optional supported upgrade-smoke baseline server image.
# MEMOS_SMOKE_KEEP_RESOURCES=0     # Set 1 only to retain disposable smoke containers for debugging.

# Legacy server tarball installer/entrypoint compatibility options (scripts/).
# These are not native desktop installer settings or root Compose overrides.
# MEMOS_VERSION=                  # Explicit server tarball version; otherwise query its latest release.
# MEMOS_INSTALL_DIR=              # Destination for the legacy server executable.
# MEMOS_SKIP_CHECKSUM=0           # Keep checksum verification enabled.
# MEMOS_INSTALL_QUIET=0
# MEMOS_UID=10001                 # Legacy container entrypoint ownership only.
# MEMOS_GID=10001
# MEMOS_DSN_FILE=                 # Legacy entrypoint secret-file alternative to MEMOS_DSN.

# OS/tooling-owned variables are intentionally not application configuration:
# ProgramData (Windows), HOME/USERPROFILE, PATH, CI and CARGO_TARGET_DIR.
# WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS is rejected by native smoke tests.
# MEMOS_ENTRYPOINT_SWITCHED is an internal re-execution marker; never set it.
# The check-env script inventories literal reads plus Viper and Compose settings;
# see docs/ENVIRONMENT_AND_LOCAL_TESTS.md for scope and limitations.
