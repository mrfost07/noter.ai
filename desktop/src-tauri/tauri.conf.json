{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noter.ai",
  "version": "26.10.16-rc.2",
  "identifier": "ai.noter.desktop",
  "build": {
    "frontendDist": "../dist-loader"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Noter.ai",
        "width": 1320,
        "height": 860,
        "minWidth": 56,
        "minHeight": 120,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Noter.ai",
    "category": "Productivity",
    "shortDescription": "AI assisted notes and meeting review",
    "createUpdaterArtifacts": false,
    "windows": {
      "wix": { "version": "26.10.16.2" }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "bundleVersion": "26.10.16",
      "infoPlist": "Info.plist"
    },
    "linux": {
      "appimage": { "bundleMediaFramework": true }
    },
    "externalBin": [
      "binaries/memos-server"
    ],
    "icon": [
      "icons/noter-v2/32x32.png",
      "icons/noter-v2/128x128.png",
      "icons/noter-v2/128x128@2x.png",
      "icons/noter-v2/icon.icns",
      "icons/noter-v2/icon.ico",
      "icons/noter-v2/icon.png"
    ]
  }
}
