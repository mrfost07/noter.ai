# Generated output
/build/
/bin/
/tmp/
/memos
/memos.exe
coverage.out
# Frontend bundles: web/dist from `pnpm build`, and
# server/frontend/dist from `pnpm release`, which go:embed bakes
# into the binary.
dist/

# Local development files
.env
.env.*
!.env.example
.DS_Store
.idea/
.vscode/
/.worktrees/
# Project-scoped pnpm store, created under whichever directory pnpm runs in
# when --config.store-dir is set without an existing store; it contains a
# symlink back to the workspace.
.pnpm-store/

# Local audit evidence contains machine paths, screenshots and generated media.
# Publish portable release notes instead of these workstation artifacts.
/docs/verification/
# Workstation-specific implementation-session documents stay local as well.
/docs/design/meeting-note-taking-with-ai.md
/docs/design/noter-local-library-and-meeting-review.md
